<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Sales\Model\Order\Creditmemo\Total\Tax">
        <plugin name="geissweb_creditmemo_tax_shield_core_tax"
                type="Geissweb\CreditmemoTax\Plugin\ShieldCoreCreditmemoTax"/>
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Invoice">
        <plugin name="geissweb_creditmemo_tax_exclude_adjustment_tax"
                type="Geissweb\CreditmemoTax\Plugin\ExcludeAdjustmentTaxFromInvoiceRefunded"/>
    </type>
    <type name="Magento\Tax\Helper\Data">
        <plugin name="geissweb_creditmemo_tax_calculated_taxes"
                type="Geissweb\CreditmemoTax\Plugin\AddAdjustmentTaxToCalculatedTaxes"/>
    </type>
    <virtualType name="CreditmemoRelationsComposite">
        <arguments>
            <argument name="relationProcessors" xsi:type="array">
                <item name="geissweb_adjustment_tax" xsi:type="object">Geissweb\CreditmemoTax\Model\ResourceModel\Creditmemo\AdjustmentTaxRelation</item>
            </argument>
        </arguments>
    </virtualType>
</config>
